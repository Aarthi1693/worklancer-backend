generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROVIDER
  MASTER
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskType {
  DIGITAL
  FIELD
}

enum SubmissionStatus {
  PENDING
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum NotificationType {
  APPLICATION
  CHAT
  PAYMENT
  PROJECT
  SYSTEM
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  FAILED
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role Role

  skills     String?
  experience Int?
  rating     Float   @default(0)

  resetToken       String?
  resetTokenExpiry DateTime?

  // KYC
  kycStatus             String?   @default("NOT_STARTED")
  kycVerifiedAt         DateTime?
  kycScore              Int?
  kycIdPhoto            String?
  kycPanCard            String?
  kycSelfie             String?
  kycProfilePhoto       String?
  kycVerificationReport Json?
  kycDob                String?
  kycGender             String?
  kycAddress            String?
  kycCity               String?
  kycState              String?
  kycPincode            String?
  kycPhone              String?

  phone String?
  bio String?
  location String?
  companyName String?
  providerType String?
  industry String?
  website String?
  businessAddress String?
  companyDescription String?
  contactPerson String?
  companySize String?
  portfolioLink String?
  linkedinUrl String?
  githubUrl String?
  hourlyRate Float?
  availability String?
  avatar String?
  resume String?
  gstNumber String?
  companyRegistrationNumber String?
  preferredRole String?

  applications Application[]

  notifications Notification[]

  projects Project[] @relation("ProviderProjects")

  aiPlans AIProjectPlan[]

  // Chat
  providerConversations Conversation[] @relation("ProviderConversation")
  masterConversations   Conversation[] @relation("MasterConversation")
  messages              Message[]

  providerPayments Payment[] @relation("ProviderPayments")

  masterPayments Payment[] @relation("MasterPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(uuid())

  title       String
  description String

  budget Float

  requiredSkills String

  taskType TaskType @default(DIGITAL)

  status ProjectStatus @default(OPEN)

  providerId String

  provider User @relation("ProviderProjects", fields: [providerId], references: [id], onDelete: Cascade)

  applications Application[]

  conversations Conversation[]

  aiPlans AIProjectPlan[]

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(uuid())

  userId    String
  projectId String

  matchScore Float @default(0)

  status String @default("PENDING")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  submission Submission?

  createdAt DateTime @default(now())
}

model Submission {
  id String @id @default(uuid())

  applicationId String @unique

  githubLink String?

  deploymentLink String?

  reportFile String?

  imageUrls String?

  location String?

  completionDate DateTime?

  description String

  status SubmissionStatus @default(PENDING)

  feedback String?

  reviewedAt DateTime?

  reviewedBy String?

  approvedAt DateTime?

  application Application @relation(fields: [applicationId], references: [id])

  payment Payment?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(uuid())

  projectId String

  providerId String

  masterId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider User @relation("ProviderConversation", fields: [providerId], references: [id], onDelete: Cascade)

  master User @relation("MasterConversation", fields: [masterId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(uuid())

  conversationId String

  senderId String

  message String

  isRead Boolean @default(false)

  readAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  IN_PROGRESS
}

model AIProjectPlan {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String?
  projectType     String?
  budget          Float?
  deadline        DateTime?
  requiredSkills  String?
  teamSize        Int?
  priority        String?
  status          PlanStatus @default(ACTIVE)
  planData        Json
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id String @id @default(uuid())

  userId String

  type NotificationType

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String    @id @default(uuid())
  submissionId String    @unique
  projectId    String
  providerId   String
  userId       String
  amount       Float
  status       PaymentStatus @default(PENDING)
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id])
  project    Project    @relation(fields: [projectId], references: [id])
  provider   User       @relation("ProviderPayments", fields: [providerId], references: [id], onDelete: Cascade)
  user       User       @relation("MasterPayments", fields: [userId], references: [id], onDelete: Cascade)
}
