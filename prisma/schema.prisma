generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROVIDER
  MASTER
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskType {
  DIGITAL
  FIELD
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  APPLICATION
  CHAT
  PAYMENT
  PROJECT
  SYSTEM
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role Role

  skills     String?
  experience Int?
  rating     Float   @default(0)

  resetToken       String?
  resetTokenExpiry DateTime?

  applications Application[]

  notifications Notification[]

  projects Project[]

  // Chat
  providerConversations Conversation[] @relation("ProviderConversation")
  masterConversations   Conversation[] @relation("MasterConversation")
  messages              Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(uuid())

  title       String
  description String

  budget Float

  requiredSkills String

  taskType TaskType @default(DIGITAL)

  status ProjectStatus @default(OPEN)

  providerId String

provider User @relation(fields: [providerId], references: [id])

  applications Application[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id String @id @default(uuid())

  userId    String
  projectId String

  matchScore Float @default(0)

  status String @default("PENDING")

  user User @relation(fields: [userId], references: [id])

  project Project @relation(fields: [projectId], references: [id])

  submission Submission?

  createdAt DateTime @default(now())
}

model Submission {
  id String @id @default(uuid())

  applicationId String @unique

  githubLink String?

  deploymentLink String?

  reportFile String?

  imageUrls String?

  location String?

  completionDate DateTime?

  description String

  status SubmissionStatus @default(PENDING)

  application Application @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(uuid())

  projectId String

  providerId String

  masterId String

  project Project @relation(fields: [projectId], references: [id])

  provider User @relation("ProviderConversation", fields: [providerId], references: [id])

  master User @relation("MasterConversation", fields: [masterId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(uuid())

  conversationId String

  senderId String

  message String

  isRead Boolean @default(false)

  readAt DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  sender User @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())

  userId String

  type NotificationType

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
